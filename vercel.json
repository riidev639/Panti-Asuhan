{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.4" }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/public/images/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://panti-asuhan-delta.vercel.app",

        "LARAVEL_STORAGE_PATH": "/tmp/panti-asuhan/storage",
        "APP_CONFIG_CACHE": "/tmp/panti-asuhan/bootstrap/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/panti-asuhan/bootstrap/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/panti-asuhan/bootstrap/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/panti-asuhan/bootstrap/cache/routes-v7.php",
        "APP_SERVICES_CACHE": "/tmp/panti-asuhan/bootstrap/cache/services.php",
        "VIEW_COMPILED_PATH": "/tmp/panti-asuhan/storage/framework/views",

        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "LOG_STACK": "stderr",
        "SESSION_DRIVER": "cookie",
        "SESSION_ENCRYPT": "true"
    }
}
